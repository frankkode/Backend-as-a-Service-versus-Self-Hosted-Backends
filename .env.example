# Repo-root environment file, used by tests/, shared/k6/ and the benchmark driver commands
# described in Platform_Build_Guide.md. Copy to .env and fill in real values; .env itself is
# git-ignored and must never be committed.
#
# Populate with: ./scripts/set_env.sh KEY value

# --- Supabase variant ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_JWT=
SUPABASE_TEST_ORG_ID=
SUPABASE_OTHER_ORG_RECORD_ID=

# --- Django variant ---
DJANGO_VPS_IP=
DJANGO_BASE_URL=
DJANGO_USER_JWT=
DJANGO_TEST_ORG_ID=
DJANGO_OTHER_ORG_RECORD_ID=
