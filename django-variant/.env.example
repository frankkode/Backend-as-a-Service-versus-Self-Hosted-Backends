# django-variant/.env — read by docker-compose.yml (env_file) and config/settings.py.
# Copy to django-variant/.env and fill in real values; .env itself is git-ignored.

# Django
DJANGO_SECRET_KEY=
GUNICORN_WORKERS=5

# Database (docker-compose db service)
DB_PASSWORD=
DATABASE_URL=postgresql://appuser:${DB_PASSWORD}@db:5432/appdb

# Object storage (file uploads) — leave blank in a fresh checkout; upload endpoints will error
# until these point at a real S3-compatible bucket, see README.md "Security note".
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
